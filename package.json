{
  "name": "kinetic-wp",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "preview": "npm-run-all --parallel sync wpstart tailwindwatch",
    "sync": "browser-sync start -p romonet.local --files '**/*.php' 'build/*.js' 'build/*.css'",
    "buildwp": "wp-scripts build",
    "build": "npm-run-all --sequential buildwp tailwindbuild",
    "wpstart": "wp-scripts start",
    "start": "npm-run-all --parallel wpstart tailwindwatch",
    "tailwindbuild": "tailwindcss -i ./src/index.css -o ./build/index.css --minify",
    "tailwindwatch": "tailwindcss -i ./src/index.css -o ./build/index.css --watch --minify",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "build:alpine": "vite build",
    "plugin-zip": "wp-scripts plugin-zip"
  },
  "files": [
    "assets/**",
    "build/**",
    "includes/**",
    "template-parts/**",
    "woocommerce",
    "*.php",
    "style.css"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@wordpress/scripts": "^34.1.0",
    "browser-sync": "^3.0.4",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "alpinejs": "^3.16.2"
  }
}
